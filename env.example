# Copy to .env in project root (never commit .env)
# For Vercel production: set these in Vercel Dashboard → Project Settings → Environment Variables
#
# Production architecture:
#   Frontend → Vercel SPA (same domain)
#   Backend  → Vercel serverless function at /api/* (routed via vercel.json)
#   MongoDB  → MongoDB Atlas (MONGODB_URI required in Vercel Dashboard)

# ── Frontend (Vite) ──
# Local dev: leave as localhost (or rely on vite proxy which forwards /api → :5000)
# Production: LEAVE UNSET or set to "/api" — the vercel.json rewrite handles routing
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=
VITE_WHATSAPP_NUMBER=

# Optional EmailJS (client-side fallback notifications)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ── Server ──
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas (required)
MONGODB_URI=
MONGODB_DB_NAME=edugram

# JWT (required)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d

# Google OAuth (required for Google Sign-In)
# Must be the same value as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Admin seed account (npm run seed)
ADMIN_EMAIL=admin@edugram.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=EduGram Admin

# SMTP / Nodemailer (forgot password, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@edugram.com
ADMIN_EMAIL_NOTIFY=admin@edugram.com

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (video uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
