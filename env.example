# Copy this file to .env locally (do NOT commit .env)
# In Vercel: Project -> Settings -> Environment Variables

# Firebase (required for production features)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (optional – contact, welcome, payment confirmation)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Razorpay (serverless API only – set in Vercel env or in .env for local API)
# Get keys from https://dashboard.razorpay.com
# For local payment API: run "npm run dev:full" (Vercel dev) instead of "npm run dev"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

